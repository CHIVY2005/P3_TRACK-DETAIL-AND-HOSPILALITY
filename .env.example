# Application Settings
ENV=development
API_V1_STR=/api/v1
PROJECT_NAME="Guardian Pricing Intelligence Platform"

# PostgreSQL Database Settings
USE_SQLITE=True
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=guardian_db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# pgAdmin Settings
PGADMIN_EMAIL=admin@guardian.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8080

# Scraper Settings
REQUEST_TIMEOUT=15
MAX_RETRIES=3
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/115.0.0.0 Safari/537.36"

# Pricing Index Configuration
ALERT_UNDERPRICE_THRESHOLD=0.10 # Alert if competitor is >10% cheaper
ALERT_OVERPRICE_THRESHOLD=0.10 # Alert if competitor is >10% more expensive
PRICING_TARGET_SKU_COUNT=200
PRICING_FRESHNESS_HOURS=24
AGENT_SCHEDULER_ENABLED=True
AGENT_SCHEDULE_INTERVAL_SECONDS=86400

# Apify Scraper Token (Apify credit applied)
APIFY_API_TOKEN=your_apify_api_token_here

# Langfuse Observability Keys (Langfuse Free tier applied)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
