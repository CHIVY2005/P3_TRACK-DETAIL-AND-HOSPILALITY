# ==========================================
# CẤU HÌNH MÔI TRƯỜNG: GUARDIAN PRICING PLATFORM
# ==========================================

# 1. FastAPI Backend Configuration
# Cấu hình cơ bản cho server FastAPI chạy cục bộ
ENV=development
API_V1_STR=/api/v1
PROJECT_NAME="Guardian Pricing Intelligence Platform"
HOST=0.0.0.0
PORT=8000
SECRET_KEY="your-super-secret-key-for-jwt-or-session-here"

# PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=guardian_db
# Dành cho SQLAlchemy kết nối trực tiếp:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guardian_db

# Redis Settings (Dùng cho caching hoặc Celery worker nếu có)
REDIS_HOST=localhost
REDIS_PORT=6379

# pgAdmin Settings (Dùng để quản lý Postgres qua Web UI)
PGADMIN_EMAIL=admin@guardian.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8080

# 3. Web Scraping / Apify Integration
# Tích hợp cào dữ liệu qua Apify.
# Hướng dẫn lấy Token: Đăng nhập https://console.apify.com/ -> Cài đặt (Settings) -> Integrations -> Copy "API token".
APIFY_API_TOKEN="your_apify_api_token_here"

# Scraper Provider Toggle (apify | brightdata | zenrows)
SCRAPER_PROVIDER=apify

# Apify Actor IDs — one per platform (thay bằng Actor ID thực trên Apify Store)
APIFY_ACTOR_SHOPEE=xtracto/shopee-scraper
APIFY_ACTOR_LAZADA=xtracto/lazada-scraper
APIFY_ACTOR_TIKTOK=xtracto/tiktok-scraper
APIFY_ACTOR_GRABMART=xtracto/grabmart-scraper
APIFY_ACTOR_HASAKI=xtracto/hasaki-scraper
APIFY_ACTOR_PHARMACITY=xtracto/pharmacity-scraper

# Fallback to fixture JSON khi APIFY token chưa set hoặc API lỗi
APIFY_FIXTURE_FALLBACK=true
APIFY_FIXTURE_PATH=backend/data/apify_fallback_fixture.json

# Cấu hình Scraper cơ bản
REQUEST_TIMEOUT=15
MAX_RETRIES=3
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/115.0.0.0 Safari/537.36"

# 4. AI & Agent Integration (LLM)
# Khai báo khóa API cho các mô hình ngôn ngữ lớn (chọn 1 trong 2 hoặc cả 2)
OPENAI_API_KEY="sk-your-openai-api-key-here"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"

# 5. Giám sát & Logging (LangSmith)
# Cấu hình tracking cho LangChain/LangGraph để debug luồng chạy của AI Agent
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY="lsv2_your_langchain_api_key_here"
LANGCHAIN_PROJECT="Guardian_Pricing_Agent_Dev"

# 6. Pricing Index Configuration
# Ngưỡng cảnh báo biến động giá (so với Guardian)
ALERT_UNDERPRICE_THRESHOLD=0.10 # Alert if competitor is >10% cheaper
ALERT_OVERPRICE_THRESHOLD=0.10 # Alert if competitor is >10% more expensive
